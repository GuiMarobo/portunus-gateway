{
  "name": "@portunus/mock-provider",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc -b tsconfig.build.json && pnpm run \"/^dev:/\"",
    "dev:compile": "tsc -b tsconfig.build.json --watch --preserveWatchOutput",
    "dev:serve": "node --watch --env-file-if-exists=.env dist/main.js",
    "build": "tsc -b tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@portunus/common": "workspace:*",
    "fastify": "5.11.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "openai": "7.59.0",
    "pino-pretty": "13.2.0"
  }
}
