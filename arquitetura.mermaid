flowchart LR
    %% ===== Clientes =====
    subgraph CLI["Clientes"]
        APP["Aplicações dos clientes<br/>(SDK OpenAI, só troca a base_url)"]
        ADM["Admin / Dev de IA"]
        EVAL["CLI de Evals<br/>(local e CI)"]
    end

    %% ===== Gateway =====
    subgraph GW["Portunus Gateway (NestJS)"]
        direction TB
        API["API compatível com OpenAI<br/>/v1/chat/completions<br/>/v1/embeddings"]
        AUTH["Auth + Tenant<br/>(API key hasheada)"]
        RL["Rate limit + Orçamento"]
        CACHE["Cache<br/>exato + semântico"]
        ROUTER["Router<br/>alias, retry, circuit breaker, fallback"]
        ADAPT["Provider Adapters<br/>OpenAI, Anthropic, Mock"]
        PUB["Publicador de eventos<br/>(com outbox)"]
        ASYNCAPI["API assíncrona e Batch<br/>/v1/async/*"]
        ADMINAPI["Admin API<br/>tenants, chaves, preços, relatórios<br/>busca de logs"]
    end

    %% ===== Workers =====
    subgraph WK["Workers"]
        direction TB
        JOBW["Worker assíncrono<br/>(BullMQ)"]
        IDX["Consumidor Indexer"]
        AGG["Consumidor Aggregator"]
        ALR["Consumidor Alerter"]
    end

    %% ===== Dados =====
    subgraph DATA["Dados e mensageria"]
        direction TB
        PG[("PostgreSQL + pgvector<br/>tenants, chaves, preços,<br/>cache semântico, agregados, outbox")]
        REDIS[("Redis<br/>cache exato, rate limit,<br/>circuit breaker, filas BullMQ")]
        RMQ{{"RabbitMQ<br/>exchange gateway.events<br/>filas + DLQ"}}
        ES[("Elasticsearch<br/>request-logs-*")]
    end

    %% ===== Provedores =====
    subgraph PROV["Provedores de LLM"]
        OAI["OpenAI"]
        ANT["Anthropic"]
        MOCK["Mock<br/>(testes e carga)"]
    end

    %% ===== Observabilidade =====
    subgraph OBS["Observabilidade"]
        direction TB
        OTEL["OpenTelemetry Collector"]
        PROM["Prometheus<br/>métricas"]
        LOKI["Loki<br/>logs"]
        TEMPO["Tempo<br/>traces"]
        GRAF["Grafana<br/>dashboards e alertas"]
    end

    %% ===== Fluxo síncrono =====
    APP -->|"HTTPS + API key"| API
    API --> AUTH --> RL --> CACHE --> ROUTER --> ADAPT
    ADAPT --> OAI
    ADAPT --> ANT
    ADAPT --> MOCK
    ROUTER --> PUB

    AUTH -.-> PG
    AUTH -.-> REDIS
    RL -.-> REDIS
    CACHE -.->|"exato"| REDIS
    CACHE -.->|"semântico"| PG
    ROUTER -.->|"estado do circuit breaker"| REDIS
    PUB -.->|"outbox"| PG
    PUB ==>|"usage events"| RMQ

    %% ===== Eventos =====
    RMQ ==> IDX
    RMQ ==> AGG
    RMQ ==> ALR
    IDX --> ES
    AGG --> PG
    AGG -.->|"contadores de orçamento"| REDIS
    ALR -->|"alertas"| GRAF

    %% ===== Assíncrono =====
    APP -->|"jobs e batch"| ASYNCAPI
    ASYNCAPI --> REDIS
    REDIS --> JOBW
    JOBW --> ROUTER
    JOBW -.->|"webhook com HMAC"| APP

    %% ===== Admin e Evals =====
    ADM --> ADMINAPI
    ADMINAPI --> PG
    ADMINAPI --> ES
    EVAL -->|"roda suites via API"| API

    %% ===== Telemetria =====
    GW -.->|"OTLP"| OTEL
    WK -.->|"OTLP"| OTEL
    OTEL --> PROM
    OTEL --> LOKI
    OTEL --> TEMPO
    PROM --> GRAF
    LOKI --> GRAF
    TEMPO --> GRAF
